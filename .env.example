# 本地运行用（不要提交！已被 .gitignore 忽略）
# CI 运行请在仓库 Settings → Secrets and variables → Actions 里配置同名 Secret

# FRED 宏观数据 API key（免费申请：https://fredaccount.stlouisfed.org/apikeys）
# 不配置则 LSI / 宏观模块自动降级，看板其余部分正常
FRED_API_KEY=

# 邮件（可选；不配置则只生成 mail_preview.html 不发送）
ETF_SMTP_USER=
ETF_SMTP_PASS=
ETF_MAIL_TO=

# 可选：第二个发件账号（备份通道，如 Gmail 应用专用密码）
ETF_SMTP_USER_2=
ETF_SMTP_PASS_2=
ETF_MAIL_TO_2=
